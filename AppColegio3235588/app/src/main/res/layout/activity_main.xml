<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView27"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="57dp"
        android:layout_marginBottom="15dp"
        android:text="INDEX"
        android:textSize="60sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="1dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView27">

        <Button
            android:id="@+id/btnEstudiante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="IrEstudiante"
            android:text="Estudiante"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/BtnProfesor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="IrProfesor"
            android:text="Profesor"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMateria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="IrMateria"
            android:text="Materia"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAcudiente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="IrAcudiente"
            android:text="Acudiente"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- MaterialToolbar Solo Titulo -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/ToolbarMain"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/design_default_color_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Inventario SENA"
        app:titleTextColor="@android:color/white" />

    <!-- Contenedor Principal Centrado -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ToolbarMain">

        <!-- 1. Boton Ambiente -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/BtnAmbiente"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#4CAF50"
            android:onClick="IrAmbiente"
            android:text="Ambiente"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_ambiente"
            app:iconGravity="textStart"
            app:iconPadding="16dp"
            app:iconSize="28dp"
            app:iconTint="@android:color/white" />

        <!-- 2. Boton Elementos -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/BtnElementos"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#2196F3"
            android:onClick="IrElemento"
            android:text="Elementos"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_elemento"
            app:iconGravity="textStart"
            app:iconPadding="16dp"
            app:iconSize="28dp"
            app:iconTint="@android:color/white" />

        <!-- 3. Boton Instructor -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/BtnInstructor"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#FF9800"
            android:onClick="IrInstructor"
            android:text="Instructor"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_instructor"
            app:iconGravity="textStart"
            app:iconPadding="16dp"
            app:iconSize="28dp"
            app:iconTint="@android:color/white" />

        <!-- 4. Boton Novedades -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/BtnNovedades"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#5E35B1"
            android:onClick="IrNovedades"
            android:text="Novedades"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_novedades"
            app:iconGravity="textStart"
            app:iconPadding="16dp"
            app:iconSize="28dp"
            app:iconTint="@android:color/white" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
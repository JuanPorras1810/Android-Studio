<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CalculadoraActivity"
    tools:layout_editor_absoluteX="-6dp"
    tools:layout_editor_absoluteY="-90dp">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:text="Calculadora"
        android:textColor="@color/material_dynamic_primary10"
        android:textSize="60sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textView2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.505"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.876" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:text="Numero 1"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/TxtNum1Calc"
        app:layout_constraintStart_toStartOf="@+id/textView" />

    <EditText
        android:id="@+id/TxtNum1Calc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="37dp"
        android:ems="10"
        android:inputType="number"
        app:layout_constraintBottom_toTopOf="@+id/textView3"
        app:layout_constraintEnd_toEndOf="@+id/textView2"
        app:layout_constraintStart_toEndOf="@+id/textView2" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Numero 2"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/TxtNum2Calc"
        app:layout_constraintStart_toStartOf="@+id/TxtNum1Calc" />

    <EditText
        android:id="@+id/TxtNum2Calc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="50dp"
        android:ems="10"
        android:inputType="number"
        app:layout_constraintBottom_toTopOf="@+id/BtnSumarCalc"
        app:layout_constraintEnd_toEndOf="@+id/textView3"
        app:layout_constraintStart_toEndOf="@+id/textView3" />

    <EditText
        android:id="@+id/TxtResulCalc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="76dp"
        android:ems="10"
        android:gravity="center"
        android:inputType="number"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/BtnRestarCalc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="27dp"
        android:backgroundTint="#4CAF50"
        android:onClick="Restar"
        android:text="Restar"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/BtnDividCalc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/BtnSumarCalc" />

    <Button
        android:id="@+id/BtnSumarCalc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="27dp"
        android:backgroundTint="#4CAF50"
        android:onClick="Sumar"
        android:text="Sumar"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/BtnMultiCalc"
        app:layout_constraintEnd_toStartOf="@+id/BtnRestarCalc"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/BtnDividCalc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="2dp"
        android:backgroundTint="#4CAF50"
        android:onClick="Dividir"
        android:text="Dividir"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/BtnMultiCalc"
        app:layout_constraintTop_toTopOf="@+id/BtnMultiCalc" />

    <Button
        android:id="@+id/BtnMultiCalc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="81dp"
        android:backgroundTint="#4CAF50"
        android:onClick="Multiplicar"
        android:text="Multiplicar"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/TxtResulCalc"
        app:layout_constraintEnd_toStartOf="@+id/BtnDividCalc"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/button"
        android:layout_width="238dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="262dp"
        android:layout_marginBottom="90dp"
        android:backgroundTint="#001E8C"
        android:gravity="clip_vertical"
        android:onClick="Regresar"
        android:text="Regresar"
        android:textSize="30sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
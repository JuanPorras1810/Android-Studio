<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CalculadoraActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="109dp"
        android:layout_marginBottom="75dp"
        android:text="Calculadora"
        android:textColor="@color/material_dynamic_primary10"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/TxtNum1Calc"
        app:layout_constraintStart_toStartOf="@+id/textView2"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginTop="197dp"
        android:layout_marginBottom="86dp"
        android:text="Numero 1"
        app:layout_constraintBottom_toTopOf="@+id/textView3"
        app:layout_constraintStart_toStartOf="@+id/TxtNum1Calc"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="89dp"
        android:text="Numero 2"
        app:layout_constraintBottom_toTopOf="@+id/BtnSumarCalc"
        app:layout_constraintStart_toStartOf="@+id/TxtNum2Calc"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <EditText
        android:id="@+id/TxtNum1Calc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="56dp"
        android:ems="10"
        android:inputType="number"
        app:layout_constraintBottom_toTopOf="@+id/TxtNum2Calc"
        app:layout_constraintEnd_toEndOf="@+id/TxtNum2Calc"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <EditText
        android:id="@+id/TxtNum2Calc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="38dp"
        android:layout_marginBottom="33dp"
        android:ems="10"
        android:inputType="number"
        app:layout_constraintBottom_toTopOf="@+id/BtnRestarCalc"
        app:layout_constraintEnd_toEndOf="@+id/BtnRestarCalc"
        app:layout_constraintTop_toBottomOf="@+id/TxtNum1Calc" />

    <Button
        android:id="@+id/BtnSumarCalc"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="59dp"
        android:layout_marginBottom="28dp"
        android:backgroundTint="#4CAF50"
        android:onClick="Sumar"
        android:text="Sumar"
        app:layout_constraintBottom_toTopOf="@+id/BtnDividCalc"
        app:layout_constraintEnd_toStartOf="@+id/BtnRestarCalc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <Button
        android:id="@+id/BtnRestarCalc"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="60dp"
        android:layout_marginBottom="28dp"
        android:backgroundTint="#4CAF50"
        android:onClick="Restar"
        android:text="Restar"
        app:layout_constraintBottom_toTopOf="@+id/BtnMultiCalc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/BtnSumarCalc"
        app:layout_constraintTop_toBottomOf="@+id/TxtNum2Calc" />

    <Button
        android:id="@+id/BtnMultiCalc"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="60dp"
        android:layout_marginBottom="35dp"
        android:backgroundTint="#4CAF50"
        android:onClick="Multiplicar"
        android:text="Multiplicar"
        app:layout_constraintBottom_toTopOf="@+id/TxtResulCalc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/BtnDividCalc"
        app:layout_constraintTop_toBottomOf="@+id/BtnRestarCalc" />

    <Button
        android:id="@+id/BtnDividCalc"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="59dp"
        android:layout_marginBottom="187dp"
        android:backgroundTint="#4CAF50"
        android:onClick="Dividir"
        android:text="Dividir"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/BtnMultiCalc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/BtnSumarCalc" />

    <EditText
        android:id="@+id/TxtResulCalc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="38dp"
        android:layout_marginBottom="107dp"
        android:ems="10"
        android:focusable="false"
        android:gravity="center"
        android:inputType="number"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/BtnMultiCalc"
        app:layout_constraintTop_toBottomOf="@+id/BtnMultiCalc" />

</androidx.constraintlayout.widget.ConstraintLayout>